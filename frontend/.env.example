VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
VITE_SENTRY_DSN=https://your-sentry-dsn-here
VITE_ADMIN_EMAILS=email1@example.com,email2@example.com
# E-mail público de contato (Ajuda, Privacidade, Termos). Vazio = nenhum link de e-mail é exibido.
VITE_CONTACT_EMAIL=

# Chave PUBLICA do Web Push. Vazio = push desligado. A privada vive so nos Secrets do Supabase.
VITE_VAPID_PUBLIC_KEY=

# Copiloto (agente com IA). Vazio/false = desligado. O guia "Me mostre" funciona sem isto.
VITE_COPILOT_ENABLED=false

# Funções que dependem de migrations ainda não aplicadas. Só ligar DEPOIS de aplicá-las.
# Criação de turnos em lote (migration 20261128000100).
VITE_FEATURE_LOTE=false
# Presença com QR do local + localização (migrations 20261127000100 a 000400).
VITE_FEATURE_PRESENCA=false
# Avisos fora do app: push, e-mail e preferências (migrations 20261201000100 a 000300; push exige VITE_VAPID_PUBLIC_KEY).
VITE_FEATURE_AVISOS=false
