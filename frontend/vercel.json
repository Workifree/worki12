{
    "framework": "vite",
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                { "key": "Content-Security-Policy", "value": "frame-ancestors 'none'; object-src 'none'; base-uri 'none'; form-action 'self'" },
                { "key": "Content-Security-Policy-Report-Only", "value": "default-src 'self'; script-src 'self' 'report-sample'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://vrklakcbkcsonarmhqhp.supabase.co; font-src 'self'; connect-src 'self' https://vrklakcbkcsonarmhqhp.supabase.co wss://vrklakcbkcsonarmhqhp.supabase.co https://*.sentry.io; worker-src 'self'; manifest-src 'self'; frame-src 'none'; object-src 'none'; base-uri 'none'; form-action 'self'" },
                { "key": "X-Frame-Options", "value": "DENY" },
                { "key": "X-Content-Type-Options", "value": "nosniff" },
                { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
                { "key": "Permissions-Policy", "value": "camera=(self), geolocation=(), microphone=(), payment=(), usb=()" },
                { "key": "Cross-Origin-Opener-Policy", "value": "same-origin-allow-popups" }
            ]
        },
        {
            "source": "/convite(.*)",
            "headers": [{ "key": "Referrer-Policy", "value": "no-referrer" }]
        },
        {
            "source": "/sw.js",
            "headers": [
                { "key": "Cache-Control", "value": "no-cache" },
                { "key": "Service-Worker-Allowed", "value": "/" },
                { "key": "Content-Type", "value": "application/javascript; charset=utf-8" }
            ]
        },
        {
            "source": "/manifest.webmanifest",
            "headers": [
                { "key": "Cache-Control", "value": "no-cache" },
                { "key": "Content-Type", "value": "application/manifest+json; charset=utf-8" }
            ]
        },
        {
            "source": "/offline.html",
            "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
        },
        {
            "source": "/assets/(.*)",
            "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
        }
    ],
    "rewrites": [
        {
            "source": "/((?!assets/).*)",
            "destination": "/index.html"
        }
    ]
}
